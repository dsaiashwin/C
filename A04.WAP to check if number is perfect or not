#include <stdio.h>
int main()
{
    int n,i,sum=0;
    
    //printf("Enter the number:");
    scanf("%d",&n);
    
    if( n > 0)
    {
        for (i = 1 ; i <= ((n/2)+1) ; i++)
        {
            if (n % i ==0)
            {   
                sum+=i;
            }
            else
                continue;
            
        }
        
        if (sum != n || n==1 )
        printf("No, entered number is not a perfect number");
        
        else if (sum==n)
        printf("Yes, entered number is perfect number");
                
    }
    
    else
    printf("Error : Invalid Input, Enter only positive number.");
}
