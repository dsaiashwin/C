#include <stdio.h>
int main()
{
    int s,i,o=0,e=0;
    printf("Enter srray size: ");
    scanf("%d",&s);
    int arr[s];
    printf("Enter array Elements: ");
    for (i = 0; i < s; i++ )
    {
        scanf("%d",&arr[i]);
    }
    
    for (i=0 ; i<s ; i++)
    {
        if (arr[i]%2 == 0 )
        {
            e+=1;
        }
        
        
        else if (arr[i]%2 != 0)
        {
            o+=1;
        }
    }
    printf("Even count: %d",e);
    printf("\n");
    printf("Odd count: %d",o);
}
