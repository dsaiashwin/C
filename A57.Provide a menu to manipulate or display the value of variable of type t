#include <stdio.h>
#include <stdlib.h>
#include <string.h>
void add_ele(void *,int* ,int* ,int* ,int* ,int* ,int*);
void rem_ele(void *,int* ,int* ,int* ,int* ,int* ,int*);
void disp_ele(void *,int* ,int* ,int* ,int* ,int* ,int*);

int main()
{
    
    void *ptr = malloc(8);                                  //dynamically allocating 8 bytes of memory using malloc()
    int ch_flag1 = 0,ch_flag2 = 0 ;                         //Initializing the flag variables of Character
    int sh_flag = 0 ;                                       //Initializing the flag variable of short
    int int_flag = 0;                                       //Initializing the flag variable of Integer
    int float_flag = 0 ;                                    //Initializing the flag variable of Float
    int double_flag = 0 ;                                   //Initializing the flag variable of Double
    int c=0;
    
    do
    {   
                                                            //displaying the menu after every operation
        printf("Menu :\n");
        printf("1. Add element\n");
        printf("2. Remove element\n");
        printf("3. Display element\n");
        printf("4. Exit from the program\n");
        
        printf("Choice --->");
        scanf("%d",&c);
        
        switch (c)                                          //switch case to call the functions of respective operations
        {
            case 1:
                add_ele(ptr,&ch_flag1,&ch_flag2,&sh_flag,&int_flag,&float_flag,&double_flag);
                break;
                
            case 2:
                rem_ele(ptr,&ch_flag1,&ch_flag2,&sh_flag,&int_flag,&float_flag,&double_flag);
                break;
                
            case 3:
                disp_ele(ptr,&ch_flag1,&ch_flag2,&sh_flag,&int_flag,&float_flag,&double_flag);
                break;
                
        }    
        
    }while (c != 4);
}

void add_ele(void *ptr,int *ch_flag1,int *ch_flag2,int *sh_flag,int *int_flag,int *float_flag,int *double_flag)
{
    int a=0;

    printf("Enter the type you have to insert:\n");                                 //if user wants to add an element displaying to ask which type of element
    printf("1. int\n");
    printf("2. char\n");
    printf("3. short\n");
    printf("4. float\n");
    printf("5. double\n");
    printf("Choice ---> ");
    getchar();
    scanf(" %d",&a);                                                                //getting the user choice into variable a
    
    switch (a)                                                                      //inserting the element into particular memory block basedon flag variables
    {
        case 1:
            if (( *int_flag == 0 ) && ( *float_flag == 0 ) && ( *double_flag == 0))
            {
                printf("Enter the int : ");
                scanf("%d",(int*)ptr+1);
                *int_flag = 1;
                break;
            }
            else
            {
                printf("Memory Full\n");
                break;
            }
        
        case 2:
            if (( *ch_flag1 == 0 ) && (*double_flag == 0))
            {
                printf("Enter the char : ");
                getchar();
                scanf("%c",(char*)ptr);
                *ch_flag1 = 1;
                break;
            }
            
            else if (( *ch_flag1 != 0 ) && ( *ch_flag2 == 0 ) && ( *double_flag == 0) )
            {
                printf("Enter the char : ");
                getchar();
                scanf("%c",(char*)ptr+1);
                *ch_flag2 = 1;
                break;
            }
            else
            {
                printf("Memory Full\n");
                break;
            }
        
        case 3:
            if (( *sh_flag == 0 )  && ( *double_flag == 0))
            {
                printf("Enter the short : ");
                scanf("%hd",(short*)ptr+1);
                *sh_flag = 1;
                break;
            }
            else
            {
                printf("Memory Full\n");
                break;
            }
            
        case 4:
            if (( *int_flag == 0 ) && ( *float_flag == 0 ) && ( *double_flag == 0))
            {
                printf("Enter the float : ");
                scanf("%f",(float*)ptr+1);
                *float_flag = 1;
                break;
            }
            
            else
            {
                printf("Memory Full\n");
                break;
            }
        
        case 5:
            if (( *ch_flag1 == 0 ) && ( *ch_flag2 == 0) && ( *sh_flag == 0 ) && ( *int_flag == 0 ) && ( *float_flag == 0 ) && ( *double_flag == 0))
            {
                printf("Enter the double : ");
                scanf("%lf",(double*)ptr);
                *double_flag = 1;
                break;
            }
            
            else
            {
                printf("Memory Full\n");
                break;
            }
        
    }
    

}

void disp_ele(void *ptr,int *ch_flag1,int *ch_flag2,int *sh_flag,int *int_flag,int *float_flag,int *double_flag)
{
                                                                                        //displaying the elements based on the what all are there in memory
    printf("\n-----------------------\n");
    int  i = 0;
    if ( *ch_flag1 == 1 )
    {
        printf("%d -> %c\n",i,*((char*)ptr));
        ++i;
    }
    
    if ( *ch_flag2 == 1 )
    {
        printf("%d -> %c\n",i,((char*)ptr)[1]);
        ++i;
    }
    
    if ( *sh_flag == 1 )
    {
        printf("%d -> %hd\n",i,((short*)ptr)[1]);
        ++i;
    }
     if ( *int_flag == 1 )
    {
        printf("%d -> %d\n",i,((int*)ptr)[1]);
        ++i;
    }
     if ( *float_flag == 1 )
    {
        printf("%d -> %f\n",i,((float*)ptr)[1]);
        ++i;
    }
     if ( *double_flag == 1 )
    {
        printf("%d -> %lf\n",i,*((double*)ptr));
        ++i;
    }

    printf("-----------------------\n");
}

void rem_ele(void *ptr,int *ch_flag1,int *ch_flag2,int *sh_flag,int *int_flag,int *float_flag,int *double_flag)
{
    if ( *ch_flag1 == 1 )                                                                   //removing the element as per user requirement
    {
        printf("%d -> %c\n",0,*((char*)ptr));
    }
    
    if ( *ch_flag2 == 1 )
    {
        printf("%d -> %c\n",1,((char*)ptr)[1]);
    }
    
    if ( *sh_flag == 1 )
    {
        printf("%d -> %hd\n",2,((short*)ptr)[1]);
    }
    if ( *int_flag == 1 )
    {
        printf("%d -> %d\n",4,((int*)ptr)[1]);
    }
    if ( *float_flag == 1 )
    {
        printf("%d -> %f\n",4,((float*)ptr)[1]);
    }
    if ( *double_flag == 1 )
    {
        printf("%d -> %lf\n",0,*((double*)ptr));
    }
    
    int d;
    printf("Enter the index value to be deleted : ");
    scanf("%d",&d);
    
    if ( d == 0 )
    {
        *ch_flag1 = 0;
        *double_flag = 0;
        printf("index %d successfully deleted.\n",d);
    }
    
    else if ( d == 1 )
    {
        *ch_flag2 = 0;
        printf("index %d successfully deleted.\n",d);
    }
    
    else if ( d == 2)
    {
        *sh_flag = 0;
        printf("index %d successfully deleted.\n",d);
    }
    
    else if ( d == 4)
    {
        *int_flag = 0 ;
        *float_flag = 0;
        printf("index %d successfully deleted.\n",d);
    }
}
