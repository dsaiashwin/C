#include <stdio.h>

int main()
{
    //Write logic to check the given number is prime or not
    int n,i,f=0;
    //printf("Enter the number: ");
    scanf("%d",&n);
    
    if (n>0)
    
    {   for (i = 1; i < ((n/2)+1); i++ )
        {
            if (n%i ==0)
            {
                f+=1;
            }
        }
        if (f >= 2)
        printf("%d is not a prime number",n);
    
        else
        printf("%d is a prime number",n);
        
    }
    else
    printf("Invalid input");
}
