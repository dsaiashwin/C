#include <stdio.h>
int main()
{   
    int s,i,f;
    printf("Enter array size: ");
    scanf("%d",&s);
    int arr[s];
    
    printf("Enter array Elements: ");
    for (i = 0; i < s; i++)
    {
        scanf("%d",&arr[i]);
    }
    
    printf("Enter the Element to search: ");
    scanf("%d",&f);
    
    for (i = 0; i < s; i++)
    {
        if (arr[i] == f)
        {   printf("Element Found");
            break;
        }
        
        else if (i == (s-1) && arr[i] != f)
            printf("Not Found");
        
    }   
}
